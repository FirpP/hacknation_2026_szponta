{
  "name": "backend",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check .",
    "test": "bun test $(find src -type f -name '*.test.ts')",
    "dev:prisma:generate": "docker compose --profile dev exec backend-dev sh -c \"bunx --bun prisma generate\"",
    "dev:prisma:migrate": "docker compose --profile dev exec backend-dev sh -c \"bunx --bun prisma migrate dev\"",
    "dev:prisma:studio": "docker compose --profile dev exec backend-dev bun scripts/studio.ts",
    "db:snapshot": "sh scripts/db-snapshot.sh",
    "db:restore": "bun src/db/restore-snapshot.ts",
    "check:circular": "dpdm --circular --no-warning --no-tree --exclude 'prisma/generated' --exit-code circular:1 src/index.ts",
    "scrape:ncbr": "bun src/scrapers/ncbr.ts",
    "scrape:ppm": "bun src/scrapers/ppm.ts",
    "scrape:baztol": "bun src/scrapers/baztol.ts",
    "scrape:epo": "bun src/scrapers/epo.ts",
    "scrape:uprp": "bun src/scrapers/uprp.ts",
    "scrape:pbn": "bun src/scrapers/pbn.ts",
    "scrape:pan": "bun src/scrapers/pan.ts",
    "scrape:interreg": "bun src/scrapers/interreg.ts",
    "scrape:all": "bun src/pipeline/scrape-all.ts",
    "analyze": "bun src/analysis/analyze.ts",
    "pipeline": "bun src/pipeline/pipeline.ts",
    "cron": "bun src/pipeline/cron.ts",
    "db:migrate": "bunx --bun prisma migrate dev"
  },
  "dependencies": {
    "@hono/standard-validator": "0.4.0",
    "@hono/swagger-ui": "0.6.1",
    "@prisma/client": "7.10.1",
    "cheerio": "1.2.0",
    "hono": "4.13.13",
    "hono-openapi": "1.5.0",
    "node-cron": "4.6.0",
    "openai": "7.62.0",
    "prisma-adapter-bun-sqlite": "0.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.3",
    "dotenv": "18.0.9",
    "dpdm": "4.3.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
