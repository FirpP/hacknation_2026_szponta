generator client {
  provider   = "prisma-client"
  engineType = "client"
  runtime    = "bun"
  output     = "./generated"
}

datasource db {
  provider = "sqlite"
}

model Employee {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Model inicjatywy zgłaszanej przez instytucję
model Initiative {
  id        String           @id @default(uuid())
  status    InitiativeStatus @default(PENDING)
  createdAt DateTime         @default(now())

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  countyId Int
  county   County @relation(fields: [countyId], references: [id])

  contactPersonId String
  contactPerson   ContactPerson @relation(fields: [contactPersonId], references: [id])

  authors Author[]

  isYouthInitiative Boolean // Wśród twórców są osoby w wieku 16-30 lat?

  @@index([countyId])
}

// 1. Kto zgłasza

// Instytucja zgłaszająca
model Institution {
  id   String          @id @default(uuid())
  name String
  type InstitutionType

  initiatives Initiative[]
}

// Typ instytucji który zgłasza inicjatywę
enum InstitutionType {
  SCHOOL              @map("Szkoła")
  UNIVERSITY          @map("Uczelnia")
  MUNICIPAL           @map("Samorząd")
  OTHER_PUBLIC        @map("Inna publiczna")
  SOCIAL_ORGANIZATION @map("Organizacja społeczna")
}

// Słownik powiatów (380 rekordów), zasilany seedem
model County {
  id          Int          @id @default(autoincrement())
  name        String // np. "nowodworski"
  voivodeship String // np. "mazowieckie"
  initiatives Initiative[]

  @@unique([name, voivodeship])
  @@index([voivodeship])
}

// Osoba kontaktowa
model ContactPerson {
  id          String       @id @default(uuid())
  name        String
  email       String
  initiatives Initiative[]
}

// Twórca inicjatywy (opcjonalny, formularz zbiera imię i nazwisko oraz rolę)
model Author {
  id           String     @id @default(uuid())
  name         String
  role         String?
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id])
}

// 2. Co to jest?
// 3. Ocena
// 4. Czego szukacie

enum InitiativeStatus {
  PENDING
  PUBLISHED
  REJECTED
}
