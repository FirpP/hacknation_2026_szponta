# Wszystkie zmienne są opcjonalne (dev i prod); bez LLM_* karty się wyświetlają, ale nowe się nie analizują.
# Skopiuj do .env tylko to, co chcesz nadpisać (lub ustawić); wartości w komentarzach to domyślne:
#   cp .env.example .env
# .env jest w .gitignore i trafia do kontenerów dev i prod (env_file w docker-compose.yml), ale nie do obrazów.
#
# NODE_ENV i DATABASE_URL ustawia docker-compose.yml (osobno dla dev i prod).

# Nazwa projektu Compose (prefiks kontenerów i wolumenów). Domyślnie nazwa katalogu z repo.
# COMPOSE_PROJECT_NAME=moj-projekt

# Logowanie zapytań Prisma
# PRISMA_LOG=false

# Porty wystawiane na hoście: frontend dev, backend dev, nginx na produkcji, Prisma Studio (bun run dev:prisma:studio)
FRONTEND_PORT=8080
BACKEND_PORT=3000
APP_PORT=80
PRISMA_STUDIO_PORT=5555

# Cel proxy Vite (/api). W Dockerze ustawia go docker-compose.yml (http://backend-dev:3000), więc ta zmienna
# działa tylko przy uruchomieniu frontu poza Dockerem (bun run dev w katalogu frontend/).
# VITE_PROXY_TARGET=http://localhost:3000

# Polling plików w Vite (hot reload w Dockerze). Na Linuksie/macOS można wyłączyć, żeby oszczędzić CPU.
# Zostaw włączony, gdy repo leży na dysku Windows poza WSL.
# VITE_USE_POLLING=false

# ===================== Radar Innowacji: pipeline =====================
# Skrypty uruchamiasz z katalogu głównego (wykonują się w kontenerze backend-dev):
#   bun run db:migrate | scrape:<źródło> | scrape:all | analyze | pipeline | cron
# Gotowa baza bez scrapowania: backend/data/snapshot.db wgrywa się sam do pustej bazy przy starcie kontenera
# Po zmianie .env zwykły restart nie wystarczy (Docker czyta plik przy tworzeniu kontenera):
#   docker compose --profile dev up -d backend-dev      (na produkcji: --profile prod ... backend)

# LLM: API zgodne z OpenAI (DeepSeek). Bez tych trzech zmiennych analiza jest pomijana, a scraping działa.
# LLM_API_KEY to sekret: nie wklejaj go do tego pliku, tylko do .env.
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# Identyfikator modelu z dokumentacji dostawcy, np. deepseek-flash (jest zapisywany na karcie w polu model)
# LLM_MODEL=
# Liczba równoległych wywołań LLM (1-10) i maks. liczba znaków rekordu wysyłanego do modelu
# LLM_CONCURRENCY=2
# LLM_MAX_INPUT_CHARS=12000
# Limit tokenów odpowiedzi; u modeli rozumujących obejmuje też "myślenie", więc nie ustawiaj go nisko
# LLM_MAX_OUTPUT_TOKENS=16000

# EPO Open Patent Services (źródła epo i uprp). Darmowa rejestracja aplikacji: https://developers.epo.org
# EPO_OPS_KEY=
# EPO_OPS_SECRET=

# PBN API: token aplikacji wydaje PBN instytucjom (źródło jest pominięte bez tokenu)
# PBN_APP_ID=
# PBN_APP_TOKEN=

# User-Agent scraperów (nie wpisuj tu prywatnych danych)
# SCRAPER_USER_AGENT=RadarInnowacji-demo/0.1 (HackNation 2026 prototype; non-commercial)
# Tryb offline: scrapery czytają fixture'y zamiast sieci (to samo co flaga --offline)
# SCRAPE_OFFLINE=false
# Codzienny pipeline (scrape + analiza) startuje sam razem z serwerem, bez ręcznego uruchamiania skryptów.
# Domyślnie codziennie o 03:00 czasu polskiego. Błędna wartość przerywa start serwera.
# RADAR_CRON=0 3 * * *
# RADAR_TZ=Europe/Warsaw
# Harmonogram jest ustawiany osobno dla każdego profilu Dockera (docker-compose.yml), bo .env trafia do obu:
# dev domyślnie wyłączony, prod domyślnie włączony. Nie ustawiaj tu ogólnego RADAR_CRON_ENABLED (compose go nadpisze).
# RADAR_CRON_ENABLED_DEV=false
# RADAR_CRON_ENABLED_PROD=true
