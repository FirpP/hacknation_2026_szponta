# Wszystkie zmienne są opcjonalne (dev i prod). Do analizy LLM potrzebne są LLM_*.
# Skopiuj do .env tylko to, co chcesz nadpisać (lub ustawić):
#   cp .env.example .env
#
# NODE_ENV i DATABASE_URL ustawia docker-compose.yml (osobno dla dev i prod).

# Nazwa projektu Compose (prefiks kontenerów i wolumenów). Domyślnie nazwa katalogu z repo.
# COMPOSE_PROJECT_NAME=moj-projekt

# Logowanie zapytań Prisma
PRISMA_LOG=false

# Porty wystawiane na hoście
FRONTEND_PORT=8080
BACKEND_PORT=3000
APP_PORT=80
# Prisma Studio w dev (bun run dev:prisma:studio)
PRISMA_STUDIO_PORT=5555

# Cel proxy Vite (/api) poza Dockerem lub z innym backendem
# VITE_PROXY_TARGET=http://localhost:3000

# Polling plików w Vite (hot reload w Dockerze). Na Linuksie/macOS można wyłączyć, żeby oszczędzić CPU.
# Zostaw włączony, gdy repo leży na dysku Windows poza WSL.
# VITE_USE_POLLING=false

# ===================== Radar Innowacji: pipeline =====================
# Skrypty uruchamiasz z katalogu głównego (wykonują się w kontenerze backend-dev):
#   bun run db:migrate | scrape:<źródło> | scrape:all | analyze | pipeline | cron
# Gotowa baza bez scrapowania: bun run dev:db:restore (wgrywa backend/data/dev-snapshot.db)
# Po zmianie .env zrestartuj kontener: docker compose --profile dev up -d backend-dev

# LLM: API zgodne z OpenAI (DeepSeek). Bez tych zmiennych analiza jest pomijana, a scraping działa.
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# TODO(verify): dokładny identyfikator modelu "DeepSeek Flash" z dokumentacji dostawcy
# LLM_MODEL=
# Liczba równoległych wywołań LLM (1-10) i maks. długość rekordu wysyłanego do modelu
# LLM_CONCURRENCY=2
# LLM_MAX_INPUT_CHARS=12000
# Limit tokenów odpowiedzi; u modeli rozumujących obejmuje też "myślenie", więc nie ustawiaj go nisko
# LLM_MAX_OUTPUT_TOKENS=16000

# EPO Open Patent Services (źródła epo i uprp). Darmowa rejestracja aplikacji: https://developers.epo.org
# EPO_OPS_KEY=
# EPO_OPS_SECRET=

# PBN API: token aplikacji wydaje PBN instytucjom (źródło jest pominięte bez tokenu)
# PBN_APP_ID=
# PBN_APP_TOKEN=

# User-Agent scraperów (nie wpisuj tu prywatnych danych)
# SCRAPER_USER_AGENT=RadarInnowacji-demo/0.1 (HackNation 2026 prototype; non-commercial)
# Tryb offline: scrapery czytają fixture'y zamiast sieci (to samo co flaga --offline)
# SCRAPE_OFFLINE=false
# Harmonogram pipeline'u (node-cron, czas kontenera). Domyślnie codziennie o 03:00.
# RADAR_CRON=0 3 * * *
